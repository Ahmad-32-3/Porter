# syntax=docker/dockerfile:1
FROM golang:1.22-alpine AS build
WORKDIR /src
COPY go.mod ./
COPY . .
RUN go mod tidy && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/porter ./cmd/porter

FROM alpine:3.20
RUN apk add --no-cache ca-certificates wget \
	&& adduser -D -H -u 65532 porter
COPY --from=build /out/porter /usr/local/bin/porter
COPY porter.yaml /etc/porter/porter.yaml
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/porter", "-config", "/etc/porter/porter.yaml"]
